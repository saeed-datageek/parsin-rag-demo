# Copy these keys into Streamlit Community Cloud -> App Settings -> Secrets
# Or save locally as .streamlit/secrets.toml (ignored by Git)

OPENAI_API_KEY = "your-openai-api-key-here"
OPENAI_BASE_URL = "https://api.openai.com/v1"
OPENAI_MODEL = "gpt-4o-mini"
OPENAI_EMBED_MODEL = "text-embedding-3-small"
OPENAI_CHROMA_COLLECTION = "medical_products_openai"
VITE_API_BASE = "https://api.parsinteb.ir"

# Public Django REST API endpoint returning products (supports DRF paginated response or JSON list)
PRODUCTS_API_URL = "https://api.parsinteb.ir/shop/products/"
FRONTEND_URL = "https://parsinteb.com"
